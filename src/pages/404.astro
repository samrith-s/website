---
import RootLayout from "@/layouts/RootLayout.astro";
---

<RootLayout title="Not found — Samrith Shankar">
  <section class="notfound">
    <p class="eyebrow">Error 404</p>
    <h1 class="code">Nothing here</h1>
    <p class="copy">
      This page either moved or never existed. Either way, there is better
      reading a click away.
    </p>
    <a href="/" class="back" data-astro-prefetch>
      <span aria-hidden="true">←</span> Back home
    </a>
  </section>
</RootLayout>

<style>
  @reference "../styles/global.css";

  .notfound {
    display: grid;
    justify-items: start;
    align-content: center;
    min-height: clamp(24rem, 58vh, 34rem);
    max-width: 42ch;
  }

  .code {
    margin: 0.7rem 0 0;
    font-size: var(--text-step-4);
    font-stretch: 95%;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .copy {
    margin: 1.15rem 0 0;
    font-size: var(--text-step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 2rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms ease;

    &:hover {
      color: var(--clay);
    }
  }
</style>
