---
import projects from "@/projects.json";
---

{
  projects.length > 0 && (
    <section class="section">
      <h2 class="eyebrow section-title">Projects</h2>

      <div class="grid">
        {projects.map((project) => (
          <a
            class="card"
            href={project.site}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="card-top">
              <h3 class="card-name">{project.name}</h3>
              {!!project.tag && <span class="tag">{project.tag}</span>}
            </div>

            <p class="card-desc">{project.description}</p>

            <span class="card-foot">
              <span class="card-host">
                {project.site.replace(/^https?:\/\//, "").replace(/\/$/, "")}
              </span>
              <span class="card-arrow" aria-hidden="true">
                ↗
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  @reference "../styles/global.css";

  .section {
    padding-block: clamp(2.25rem, 1.5rem + 2.5vw, 3.25rem);
  }

  .section-title {
    margin: 0 0 1.75rem;
    font-weight: 500;
  }

  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;

    @variant sm {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: grid;
    grid-template-rows: max-content 1fr max-content;
    gap: 0.9rem;
    padding: 1.4rem 1.5rem 1.25rem;
    text-decoration: none;
    color: inherit;
    background: color-mix(in oklab, var(--paper-raised) 60%, transparent);
    border: 1px solid var(--line);
    transition:
      border-color 260ms ease,
      background-color 260ms ease,
      transform 260ms ease;

    @apply squircle;

    &:hover {
      background: color-mix(in oklab, var(--paper-raised) 95%, transparent);
      border-color: color-mix(in oklab, var(--clay) 35%, transparent);
      transform: translateY(-2px);
    }
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-name {
    margin: 0;
    font-size: var(--text-step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 260ms ease;
  }

  .card:hover .card-name {
    color: var(--clay);
  }

  .tag {
    flex-shrink: 0;
    padding: 0.18rem 0.5rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clay);
    background: color-mix(in oklab, var(--clay) 11%, transparent);
    border-radius: 999px;
  }

  .card-desc {
    margin: 0;
    font-size: var(--text-step-0);
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.2rem;
  }

  .card-host {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .card-arrow {
    color: color-mix(in oklab, var(--muted) 65%, transparent);
    transition:
      transform 260ms ease,
      color 260ms ease;
  }

  .card:hover .card-arrow {
    color: var(--clay);
    transform: translate(2px, -2px);
  }
</style>
