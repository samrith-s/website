---
import { getCollection } from "astro:content";

import FormattedDate from "./FormattedDate.astro";
import { calculateReadingTime } from "@/utils/calculate-reading-time";

const entries = await getCollection("blog");

const posts = entries
  .filter((post) => post.id.toLowerCase().trim() !== "dummy")
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    ...post,
    readingTime: calculateReadingTime(post.body ?? ""),
  }));
---

{
  posts.length > 0 && (
    <section class="section">
      <h2 class="eyebrow section-title">Writing</h2>

      <ul class="list">
        {posts.map((post, i) => (
          <li>
            <a class="row" href={`/blog/${post.id}`} data-astro-prefetch>
              <span class="row-index" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>

              <span class="row-body">
                <span class="row-title">{post.data.title}</span>
                <span class="row-meta">
                  <FormattedDate date={post.data.pubDate} />
                  {!!post.readingTime && (
                    <>
                      <span class="row-sep" aria-hidden="true">
                        ·
                      </span>
                      {post.readingTime}
                    </>
                  )}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  @reference "../styles/global.css";

  .section {
    padding-block: clamp(2.25rem, 1.5rem + 2.5vw, 3.25rem);
  }

  .section-title {
    /* Matches the Projects heading gap so the two sections read as siblings. */
    margin: 0 0 1.75rem;
    font-weight: 500;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }

  /* No rules, no fill, no chevron parked at the far edge. Spacing carries the
     structure; only the numeral and a colour shift mark the rows. */
  .row {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    gap: 0.95rem;
    text-decoration: none;
    color: inherit;
  }

  .row-index {
    font-size: 0.78rem;
    font-weight: 500;
    color: color-mix(in oklab, var(--muted) 80%, transparent);
    font-variant-numeric: tabular-nums;
    transition: color 200ms ease;
  }

  .row:hover .row-index {
    color: var(--clay);
  }

  .row-body {
    display: grid;
    gap: 0.28rem;
    min-width: 0;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: var(--text-step-1);
    font-weight: 500;
    letter-spacing: -0.018em;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: pretty;
    transition: color 200ms ease;
  }

  .row:hover .row-title {
    color: var(--clay);
  }

  .row-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .row-sep {
    opacity: 0.5;
  }
</style>
