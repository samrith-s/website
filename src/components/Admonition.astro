---
export enum Admonitions {
  NOTE = "note",
  TIP = "tip",
  DANGER = "danger",
  INFO = "info",
  IMPORTANT = "important",
  CAUTION = "caution",
}

type Props = {
  type?: Admonitions;
  title?: string;
};

const { type = Admonitions.NOTE, title } = Astro.props;
---

<aside
  class="admonition"
  data-type={type}
  data-tag={title || type.toUpperCase()}
>
  <slot />
</aside>

<style>
  @reference "../styles/global.css";

  /* Each variant only swaps one hue, so callouts read as a family rather
     than as six unrelated colour blocks. */
  .admonition {
    --tone: var(--ink);

    position: relative;
    display: grid;
    grid-auto-flow: row;
    gap: 0.5rem;
    margin-block: 1.75em;
    padding: 1.35rem 1.5rem;
    background: color-mix(in oklab, var(--tone) 6%, transparent);
    border: 1px solid color-mix(in oklab, var(--tone) 18%, transparent);
    color: var(--ink-soft);

    @apply squircle-sm;
  }

  .admonition[data-type="tip"] {
    --tone: var(--sage);
  }
  .admonition[data-type="info"] {
    --tone: var(--ink);
  }
  .admonition[data-type="important"] {
    --tone: var(--clay);
  }
  .admonition[data-type="caution"] {
    --tone: var(--ochre);
  }
  .admonition[data-type="danger"] {
    --tone: var(--rust);
  }

  .admonition::before {
    content: attr(data-tag);
    justify-self: start;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--tone) 78%, var(--ink));
  }

  .admonition :global(> p) {
    margin: 0;
  }

  .admonition :global(> p + p) {
    margin-top: 0.75em;
  }

  .admonition :global(a) {
    color: color-mix(in oklab, var(--tone) 80%, var(--ink));
  }
</style>
