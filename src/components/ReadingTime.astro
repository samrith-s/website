---
type Props = {
  readingTime?: string;
  class?: string;
};

const { readingTime, class: className } = Astro.props;
---

{
  !!readingTime && (
    <span class:list={["reading-time", className]}>{readingTime}</span>
  )
}

<style>
  .reading-time {
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
