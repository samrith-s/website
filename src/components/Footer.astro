---
import { SOCIALS } from "@/consts";
---

<footer id="footer">
  <nav class="links" aria-label="Elsewhere">
    {
      SOCIALS.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="social"
        >
          <span class="social-label">{social.label}</span>
          <span class="social-handle">{social.handle}</span>
        </a>
      ))
    }
  </nav>
</footer>

<style>
  @reference "../styles/global.css";

  #footer {
    width: 100%;
    max-width: var(--container-frame);
    margin-inline: auto;
    padding: clamp(2.5rem, 2rem + 2vw, 4rem) 1.25rem 3.5rem;

    @variant sm {
      padding-inline: 2rem;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.25rem;
  }

  .social {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 200ms ease;

    &:hover {
      color: var(--clay);
    }
  }

  .social-label {
    font-size: var(--text-step--1);
    font-weight: 500;
  }

  .social-handle {
    font-size: 0.74rem;
    color: color-mix(in oklab, var(--muted) 80%, transparent);
    transition: color 200ms ease;
  }

  .social:hover .social-handle {
    color: color-mix(in oklab, var(--clay) 70%, transparent);
  }
</style>
