---
import { cn } from "@/utils/cn";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<div
  class={cn(
    "step",
    "relative grid grid-cols-[auto_1fr] gap-x-5 gap-y-4 pb-6 last:pb-0",
    "[counter-increment:step]",
    "before:absolute before:left-3 before:top-6 before:-bottom-0 before:block before:w-0.5 before:rounded-sm before:bg-season-text/10",
    "last:before:hidden",
  )}
>
  <div
    class={cn(
      "step-indicator",
      "flex h-6 min-h-6 w-6 min-w-6 items-center justify-center rounded-full bg-season/15 text-xs font-semibold text-season",
      "before:content-[counter(step)]",
    )}
    aria-hidden="true"
  >
  </div>
  <div class="flex min-w-0 flex-col gap-1">
    <h3 class="m-0">{title}</h3>
    <div
      class="m-0 text-[0.9375rem] leading-relaxed text-season-text/85 step-content"
    >
      <slot />
    </div>
  </div>
</div>
